# Backend configuration — copy to .env and fill in real values.

# Server
PORT=5000
NODE_ENV=development

# MongoDB — set your connection string to enable contact message storage.
# Leave empty to run the server without a database (messages are not persisted).
MONGO_URI=

# Frontend origin (used by CORS). In dev the Vite proxy already forwards /api.
CLIENT_ORIGIN=http://localhost:5173

# Email delivery (optional). Contact messages are emailed here when SMTP is set.
# Leave empty to only store messages in MongoDB.
CONTACT_TO_EMAIL=

# SMTP (optional) — e.g. Gmail app password or a service like Resend/SMTP2GO.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
